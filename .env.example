# Local PostgreSQL
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kat_platform?schema=public"
# DIRECT_URL="postgresql://postgres:postgres@localhost:5432/kat_platform?schema=public"

# Neon (recommended for production) — use the POOLER URL for DATABASE_URL,
# the DIRECT (non-pooler) URL for DIRECT_URL.
# pgbouncer=true is required on the pooler URL; connect_timeout avoids cold-start failures.
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30&pgbouncer=true"
DIRECT_URL="postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=30"
REDIS_URL=""
REDIS_MESSAGES_CHANNEL="kat:messages:events"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# QStash (Upstash) REST token, separate from the Redis token above. Only needed to (re)create the
# frequent webhook-drain schedule via scripts/qstash-webhook-drain.mjs, because Vercel Hobby caps crons
# at once/day. Not read by the app at runtime; the schedule calls /api/cron/webhook-drain with CRON_SECRET.
QSTASH_TOKEN=""

# Code execution — self-hosted Judge0 CE (see scripts/judge0/)
JUDGE0_API_URL="https://code.yourdomain.com"
JUDGE0_API_KEY=""
NEXT_PUBLIC_ENABLE_SW_DEV="false"

# In-browser Python runtime (Pyodide). Optional: mirror the core to R2 with
# scripts/mirror-pyodide-to-r2.mjs, then set this to <R2_PUBLIC_URL>/pyodide/v0.26.4/.
# Unset -> loads from the public CDN. R2 must allow GET CORS from the app's origins.
NEXT_PUBLIC_PYODIDE_INDEX_URL=""

# Self-hosted Scratch editor, vanilla scratch-gui (see scripts/scratch-editor/). The KAT app iframes THIS
# custom, first-party origin, never a public Scratch/TurboWarp site. Unset -> Scratch blocks are off. The
# R2 bucket must allow BOTH PUT and GET CORS from this origin: the editor PUTs a saved .sb3 and GETs a
# presigned URL to reload a pupil's project.
NEXT_PUBLIC_SCRATCH_EDITOR_URL="https://scratch.kindleatechie.com"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth (optional — enables "Continue with Google" on login/register pages)
# Create credentials at https://console.cloud.google.com → APIs & Services → Credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
NEXT_PUBLIC_GOOGLE_OAUTH_ENABLED="false"
DEFAULT_ORGANIZATION_CODE="KAT-ORG"
DEFAULT_ORGANIZATION_NAME="KAT Academy"
DEFAULT_ORGANIZATION_DOMAIN="kindleatechie.com"

PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxx"

# School (B2B) billing: default per-seat, per-term price in NGN, used when a school is provisioned
# without an explicit price. A super-admin can override it per school at provisioning, or later via
# PATCH /api/super-admin/schools/[schoolId]. Unset -> 0, which BLOCKS that school from invoicing until
# a price is set (POST /api/school/billing/invoices returns 422 "no seat price has been set").
SCHOOL_DEFAULT_PRICE_PER_SEAT=""

# Jitsi Meet — self-hosted or 8x8.vc
# JITSI_DOMAIN: your Jitsi server domain, e.g. "meet.jit.si" or "your.server.com"
# JITSI_APP_ID: application/tenant ID issued by your Jitsi instance
# JITSI_APP_SECRET: HMAC secret for signing participant JWTs
JITSI_DOMAIN="meet.jit.si"
JITSI_APP_ID=""
JITSI_APP_SECRET=""

# Jibri recording webhook — called by the Jibri finalize script after upload
# Generate with: openssl rand -hex 32
JIBRI_WEBHOOK_SECRET=""

STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cron secret — used to authenticate the monthly parent digest endpoint.
# Generate with: openssl rand -hex 32
# Trigger: POST /api/cron/parent-digest  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# WhatsApp contact number in international format without + (e.g. 2348012345678)
# Used for the landing page WhatsApp button and Kemi's referral suggestions
NEXT_PUBLIC_WHATSAPP_NUMBER=""

# Gemini API key — powers the Kemi enrollment chatbot on the landing page
# Get one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional: defaults to "KAT Academy <SMTP_USER>"
SMTP_FROM=""
