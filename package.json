{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/next/dist/bin/next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"const {rmSync}=require('fs');for(const p of ['.next','node_modules/.cache'])rmSync(p,{recursive:true,force:true})\"",
    "postinstall": "node -e \"const {rmSync}=require('fs');for(const p of ['.next','node_modules/.cache']){try{rmSync(p,{recursive:true,force:true})}catch{}}\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "backfill:meeting-join-urls": "tsx prisma/backfill-meeting-join-urls.ts",
    "test": "vitest run --exclude \"**/integration/**\" --exclude \"**/node_modules/**\" --exclude \"**/e2e/**\"",
    "test:integration": "vitest run src/__tests__/integration --testTimeout=60000 --hookTimeout=120000"
  },
