generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id               String             @id @default(cuid())
  name             String
  code             String             @unique
  domain           String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  analyticsEvents  AnalyticsEvent[]
  challenges       Challenge[]
  cohorts          Cohort[]
  curricula        Curriculum[]
  discountCodes    DiscountCode[]
  meetings         Meeting[]
  monthlyAnalytics MonthlyAnalytics[]
  orgCodes         OrganizationCode[]
  programs         Program[]
  users            User[]
}

model OrganizationCode {
  id             String       @id @default(cuid())
  code           String       @unique
  role           UserRole
  organizationId String
  createdById    String?
  expiresAt      DateTime?
  usedAt         DateTime?
  createdAt      DateTime     @default(now())
  createdBy      User?        @relation("CreatedOrgCodes", fields: [createdById], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, role])
}

model User {
  id                                                       String                   @id @default(cuid())
  email                                                    String                   @unique
  passwordHash                                             String
  firstName                                                String
  lastName                                                 String
  role                                                     UserRole
  organizationId                                           String?
  isActive                                                 Boolean                  @default(true)
  emailVerifiedAt                                          DateTime?
  createdAt                                                DateTime                 @default(now())
  updatedAt                                                DateTime                 @updatedAt
  canGrantRetakes                                          Boolean                  @default(true)
  adminInvitesCreated                                      AdminInvite[]            @relation("AdminInvitesCreated")
  adminInvitesUsed                                         AdminInvite[]            @relation("AdminInvitesUsed")
  analyticsEvents                                          AnalyticsEvent[]
  assessmentsCreated                                       Assessment[]             @relation("AssessmentCreator")
  assessmentsVerified                                      Assessment[]             @relation("AssessmentVerifier")
  gradedAnswers                                            AssessmentAnswer[]       @relation("ManualGrader")
  assessmentResources                                      AssessmentResource[]     @relation("AssessmentResourceUploader")
  assessmentSubmissions                                    AssessmentSubmission[]
  certificatesApproved                                     Certificate[]            @relation("CertificateApprover")
  certificatesIssued                                       Certificate[]            @relation("CertificateIssuer")
  certificatesEarned                                       Certificate[]            @relation("CertificateRecipient")
  createdChallenges                                        Challenge[]              @relation("ChallengeCreator")
  gradedChallengeSubmissions                               ChallengeSubmission[]    @relation("ChallengeGrader")
  challengeSubmissions                                     ChallengeSubmission[]    @relation("ChallengeSubmitter")
  curriculumVersionsCreated                                CurriculumVersion[]      @relation("CurriculumVersionCreator")
  createdDiscountCodes                                     DiscountCode[]           @relation("CreatedDiscountCodes")
  discountRedemptions                                      DiscountCodeRedemption[]
  enrollments                                              Enrollment[]
  fellowApplications                                       FellowApplication[]      @relation("FellowApplicant")
  fellowApplicationReviews                                 FellowApplication[]      @relation("FellowApplicationReviewer")
  lessonContentsCreated                                    LessonContent[]          @relation("LessonContentCreator")
  lessonContentsReviewed                                   LessonContent[]          @relation("LessonContentReviewer")
  lessonProgress                                           LessonProgress[]
  manualGrades                                             ManualGrade[]
  hostedMeetings                                           Meeting[]                @relation("MeetingHost")
  meetingParticipations                                    MeetingParticipant[]
  assignedMentorships                                      Mentorship[]             @relation("MentorshipAssignedBy")
  fellowMentorships                                        Mentorship[]             @relation("FellowMentorships")
  studentMentorships                                       Mentorship[]             @relation("StudentMentorships")
  pinnedMessages                                           Message[]                @relation("PinnedMessages")
  sentMessages                                             Message[]                @relation("SentMessages")
  messageReceipts                                          MessageReadReceipt[]
  createdThreads                                           MessageThread[]          @relation("ThreadCreator")
  moduleGateSignOffs                                       ModuleGateStatus[]       @relation("GateSignOff")
  moduleGateStatuses                                       ModuleGateStatus[]       @relation("UserModuleGates")
  createdNotifications                                     Notification[]           @relation("NotificationCreator")
  notifications                                            Notification[]           @relation("NotificationRecipient")
  oauthAccounts                                            OAuthAccount[]
  createdOrgCodes                                          OrganizationCode[]       @relation("CreatedOrgCodes")
  childLinks                                               ParentStudent[]          @relation("ChildLinks")
  parentLinks                                              ParentStudent[]          @relation("ParentLinks")
  passwordResetTokens                                      PasswordResetToken[]
  payments                                                 Payment[]
  receiptsIssuedBy                                         PaymentReceipt[]         @relation("ReceiptIssuedBy")
  receiptsIssuedTo                                         PaymentReceipt[]         @relation("ReceiptIssuedTo")
  hostedPeerSessions                                       PeerSession[]            @relation("PeerSessionHost")
  peerSessionParticipations                                PeerSessionParticipant[]
  playgroundInvitesSent                                    PlaygroundInvite[]       @relation("PlaygroundInvitesSent")
  playgroundInvitesReceived                                PlaygroundInvite[]       @relation("PlaygroundInvitesReceived")
  profile                                                  Profile?
  projects                                                 Project[]                @relation("StudentProjects")
  projectAssets                                            ProjectAsset[]           @relation("ProjectAssetUploader")
  projectFeedback                                          ProjectFeedback[]        @relation("ProjectFeedbackAuthor")
  projectReviews                                           ProjectReview[]          @relation("ProjectReviewer")
  retakeGrantsIssued                                       RetakeGrant[]            @relation("RetakeGrantIssuer")
  retakeGrantsReceived                                     RetakeGrant[]            @relation("RetakeGrantStudent")
  taughtSchoolClasses                                              SchoolClass[]
  schoolClassTeacherAssigned SchoolClassTeacher[]     @relation("SchoolClassTeacher_assignedByIdToUser")
  schoolClassTeacherTerms    SchoolClassTeacher[]     @relation("SchoolClassTeacher_teacherIdToUser")
  schoolUnitsMarkedDelivered                                          SchoolClassUnit[]
  schoolMemberships                                         SchoolMembership[]
  superAdminInvitesCreated                                 SuperAdminInvite[]       @relation("SuperAdminInvitesCreated")
  superAdminInvitesUsed                                    SuperAdminInvite[]       @relation("SuperAdminInvitesUsed")
  testimonials                                             Testimonial[]            @relation("TestimonialAuthor")
  reviewedTestimonials                                     Testimonial[]            @relation("TestimonialReviewer")
  threadMemberships                                        ThreadParticipant[]
  organization                                             Organization?            @relation(fields: [organizationId], references: [id])
  badgesEarned                                             UserBadge[]
  sessions                                                 UserSession[]
}

model SuperAdminInvite {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  note        String?
  createdById String
  usedById    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   User      @relation("SuperAdminInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy      User?     @relation("SuperAdminInvitesUsed", fields: [usedById], references: [id])

  @@index([email, expiresAt])
  @@index([usedAt, revokedAt])
}

model AdminInvite {
  id          String    @id @default(cuid())
  email       String
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  usedById    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  role        UserRole
  createdBy   User      @relation("AdminInvitesCreated", fields: [createdById], references: [id], onDelete: Cascade)
  usedBy      User?     @relation("AdminInvitesUsed", fields: [usedById], references: [id])

  @@index([email, expiresAt])
  @@index([usedAt, revokedAt])
}

model OAuthAccount {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refreshToken      String?
  accessToken       String?
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String?
  sessionState      String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model UserSession {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                   String             @id @default(cuid())
  userId               String             @unique
  avatarUrl            String?
  phone                String?
  bio                  String?
  headline             String?
  githubUrl            String?
  linkedinUrl          String?
  twitterUrl           String?
  websiteUrl           String?
  location             String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  summaryVisibility    ProfileVisibility  @default(ORG)
  linksVisibility      ProfileVisibility  @default(PRIVATE)
  skillsVisibility     ProfileVisibility  @default(ORG)
  educationVisibility  ProfileVisibility  @default(ORG)
  experienceVisibility ProfileVisibility  @default(ORG)
  education            EducationRecord[]
  experience           ExperienceRecord[]
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills               ProfileSkill[]
}

model ProfileSkill {
  id                String   @id @default(cuid())
  profileId         String
  name              String
  level             String?
  yearsOfExperience Int?
  createdAt         DateTime @default(now())
  profile           Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model EducationRecord {
  id           String    @id @default(cuid())
  profileId    String
  school       String
  degree       String
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  isCurrent    Boolean   @default(false)
  description  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ExperienceRecord {
  id          String    @id @default(cuid())
  profileId   String
  company     String
  title       String
  startDate   DateTime?
  endDate     DateTime?
  isCurrent   Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  childId   String
  createdAt DateTime @default(now())
  child     User     @relation("ChildLinks", fields: [childId], references: [id], onDelete: Cascade)
  parent    User     @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([parentId, childId])
  @@index([childId])
}

model Program {
  id              String         @id @default(cuid())
  organizationId  String
  name            String
  slug            String         @unique
  description     String?
  level           ProgramLevel
  durationWeeks   Int            @default(0)
  monthlyFee      Decimal        @db.Decimal(10, 2)
  // Lifecycle: Draft (isPublished false) -> Published (true) -> Archived (isActive false).
  // Availability to learners/schools requires isActive AND isPublished. New programmes start Draft.
  isActive        Boolean        @default(true)
  isPublished     Boolean        @default(false)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  discountPercent Decimal?       @db.Decimal(5, 2)
  audience        CourseAudience @default(B2C)
  nerdcLevel      NerdcLevel?
  strand          Strand?
  assessments     Assessment[]
  certificates    Certificate[]
  challenges      Challenge[]
  cohorts         Cohort[]
  curriculum      Curriculum?
  discountCodes   DiscountCode[]
  enrollments     Enrollment[]
  payments        Payment[]
  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects        Project[]
  SchoolClass     SchoolClass[]

  @@index([organizationId])
}

model Cohort {
  id                     String              @id @default(cuid())
  organizationId         String
  programId              String?
  name                   String
  startsAt               DateTime
  endsAt                 DateTime
  capacity               Int?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  applicationClosesAt    DateTime?
  applicationOpen        Boolean             @default(false)
  externalApplicationFee Decimal?            @db.Decimal(10, 2)
  organization           Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program                Program?            @relation(fields: [programId], references: [id])
  fellowApplications     FellowApplication[]
  meetings               Meeting[]

  @@index([organizationId])
}

model Enrollment {
  id                 String                 @id @default(cuid())
  userId             String
  programId          String
  status             EnrollmentStatus       @default(ACTIVE)
  enrolledAt         DateTime               @default(now())
  completedAt        DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  currentPeriodEnd   DateTime?
  isBillingWaived    Boolean                @default(false)
  schoolClassId      String?
  schoolId           String?
  externalRef        String?
  submissions        AssessmentSubmission[]
  program            Program                @relation(fields: [programId], references: [id], onDelete: Cascade)
  schoolClass        SchoolClass?           @relation(fields: [schoolClassId], references: [id], onDelete: Restrict)
  school             School?                @relation(fields: [schoolId], references: [id], onDelete: Restrict)
  user               User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  periods            EnrollmentPeriod[]
  moduleGateStatuses ModuleGateStatus[]
  payments           Payment[]
  studentCredential  SchoolStudentCredential?

  @@unique([userId, programId])
  @@unique([schoolId, externalRef])
  @@index([programId])
  @@index([schoolClassId])
  @@index([schoolId])
}

model EnrollmentPeriod {
  id           String                     @id @default(cuid())
  enrollmentId String
  startedAt    DateTime                   @default(now())
  endedAt      DateTime?
  startReason  EnrollmentPeriodReason
  endReason    EnrollmentPeriodEndReason?
  createdAt    DateTime                   @default(now())
  enrollment   Enrollment                 @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@index([enrollmentId])
  @@index([enrollmentId, endedAt])
}

model Mentorship {
  id           String   @id @default(cuid())
  fellowId     String
  studentId    String
  assignedById String?
  assignedAt   DateTime @default(now())
  active       Boolean  @default(true)
  assignedBy   User?    @relation("MentorshipAssignedBy", fields: [assignedById], references: [id])
  fellow       User     @relation("FellowMentorships", fields: [fellowId], references: [id], onDelete: Cascade)
  student      User     @relation("StudentMentorships", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([fellowId, studentId])
  @@index([studentId, active])
}

model Assessment {
  id                 String                       @id @default(cuid())
  programId          String
  title              String
  description        String?
  type               AssessmentType
  totalPoints        Int
  passScore          Int
  dueDate            DateTime?
  published          Boolean                      @default(false)
  createdById        String
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  verificationStatus AssessmentVerificationStatus @default(PENDING)
  verifiedById       String?
  verifiedAt         DateTime?
  verificationNote   String?
  moduleId           String?
  weekNumber         Int?
  createdBy          User                         @relation("AssessmentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  module             Module?                      @relation(fields: [moduleId], references: [id])
  program            Program                      @relation(fields: [programId], references: [id], onDelete: Cascade)
  verifiedBy         User?                        @relation("AssessmentVerifier", fields: [verifiedById], references: [id])
  questions          AssessmentQuestion[]
  resources          AssessmentResource[]
  submissions        AssessmentSubmission[]
  projects           Project[]
  retakeGrants       RetakeGrant[]

  @@index([programId, moduleId, published, verificationStatus])
  @@index([verificationStatus, verifiedAt])
}

model AssessmentResource {
  id           String     @id @default(cuid())
  assessmentId String
  uploaderId   String
  name         String
  mimeType     String
  size         Int
  storageKey   String
  url          String
  description  String?
  uploadedAt   DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  uploader     User       @relation("AssessmentResourceUploader", fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([assessmentId])
}

model AssessmentQuestion {
  id           String             @id @default(cuid())
  assessmentId String
  prompt       String
  type         QuestionType
  points       Int
  sortOrder    Int                @default(0)
  answerKey    String?
  createdAt    DateTime           @default(now())
  answers      AssessmentAnswer[]
  options      AssessmentOption[]
  assessment   Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, sortOrder])
}

model AssessmentOption {
  id         String             @id @default(cuid())
  questionId String
  label      String
  value      String
  isCorrect  Boolean            @default(false)
  answers    AssessmentAnswer[] @relation("SelectedOption")
  question   AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([questionId])
}

model AssessmentSubmission {
  id            String             @id @default(cuid())
  assessmentId  String
  studentId     String
  enrollmentId  String?
  status        AttemptStatus      @default(SUBMITTED)
  submittedAt   DateTime           @default(now())
  gradedAt      DateTime?
  totalScore    Int                @default(0)
  autoScore     Int                @default(0)
  manualScore   Int                @default(0)
  feedback      String?
  attemptNumber Int                @default(1)
  answers       AssessmentAnswer[]
  assessment    Assessment         @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment    Enrollment?        @relation(fields: [enrollmentId], references: [id])
  student       User               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  manualGrades  ManualGrade[]
  moduleGate    ModuleGateStatus?  @relation("GateSubmission")

  @@unique([assessmentId, studentId, attemptNumber])
  @@index([studentId, status])
}

model RetakeGrant {
  id           String     @id @default(cuid())
  assessmentId String
  studentId    String
  grantedById  String
  usedAt       DateTime?
  createdAt    DateTime   @default(now())
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  grantedBy    User       @relation("RetakeGrantIssuer", fields: [grantedById], references: [id], onDelete: Cascade)
  student      User       @relation("RetakeGrantStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@index([assessmentId, studentId, usedAt])
  @@index([studentId, usedAt])
}

model AssessmentAnswer {
  id               String               @id @default(cuid())
  submissionId     String
  questionId       String
  selectedOptionId String?
  responseText     String?
  isCorrect        Boolean?
  autoScore        Int                  @default(0)
  manualScore      Int                  @default(0)
  gradedById       String?
  gradedAt         DateTime?
  feedback         String?
  gradedBy         User?                @relation("ManualGrader", fields: [gradedById], references: [id])
  question         AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption   AssessmentOption?    @relation("SelectedOption", fields: [selectedOptionId], references: [id])
  submission       AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  manualGrades     ManualGrade[]

  @@index([submissionId, questionId])
}

model ManualGrade {
  id           String               @id @default(cuid())
  submissionId String
  answerId     String?
  instructorId String
  score        Int
  feedback     String?
  createdAt    DateTime             @default(now())
  answer       AssessmentAnswer?    @relation(fields: [answerId], references: [id])
  instructor   User                 @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  submission   AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
}

model MessageThread {
  id           String              @id @default(cuid())
  type         ThreadType          @default(DIRECT)
  title        String?
  createdById  String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  description  String?
  messages     Message[]
  createdBy    User?               @relation("ThreadCreator", fields: [createdById], references: [id])
  participants ThreadParticipant[]
}

model ThreadParticipant {
  id         String        @id @default(cuid())
  threadId   String
  userId     String
  joinedAt   DateTime      @default(now())
  leftAt     DateTime?
  isArchived Boolean       @default(false)
  lastReadAt DateTime?
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id          String                @id @default(cuid())
  threadId    String
  senderId    String
  body        String
  attachments Json?
  status      MessageDeliveryStatus @default(SENT)
  createdAt   DateTime              @default(now())
  editedAt    DateTime?
  deletedAt   DateTime?
  pinnedAt    DateTime?
  pinnedById  String?
  pinnedBy    User?                 @relation("PinnedMessages", fields: [pinnedById], references: [id])
  sender      User                  @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  thread      MessageThread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  receipts    MessageReadReceipt[]

  @@index([threadId, createdAt])
  @@index([threadId, deletedAt])
  @@index([threadId, pinnedAt])
}

model MessageReadReceipt {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId, readAt])
}

model Payment {
  id                  String                  @id @default(cuid())
  userId              String
  enrollmentId        String?
  programId           String?
  provider            PaymentProvider
  status              PaymentStatus           @default(PENDING)
  amount              Decimal                 @db.Decimal(10, 2)
  currency            String                  @default("NGN")
  reference           String                  @unique
  billingMonth        DateTime
  initializedAt       DateTime                @default(now())
  verifiedAt          DateTime?
  channel             String?
  metadata            Json?
  discountCodeId      String?
  fellowApplicationId String?                 @unique
  redemption          DiscountCodeRedemption?
  discountCode        DiscountCode?           @relation(fields: [discountCodeId], references: [id])
  enrollment          Enrollment?             @relation(fields: [enrollmentId], references: [id])
  fellowApplication   FellowApplication?      @relation("ApplicationFeePayment", fields: [fellowApplicationId], references: [id])
  program             Program?                @relation(fields: [programId], references: [id])
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  receipt             PaymentReceipt?

  @@index([userId, billingMonth])
  @@index([status, provider])
}

model PaymentReceipt {
  id            String   @id @default(cuid())
  paymentId     String   @unique
  receiptNumber String   @unique
  issuedToId    String
  issuedById    String?
  issuedAt      DateTime @default(now())
  pdfUrl        String?
  issuedBy      User?    @relation("ReceiptIssuedBy", fields: [issuedById], references: [id])
  issuedTo      User     @relation("ReceiptIssuedTo", fields: [issuedToId], references: [id], onDelete: Cascade)
  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
}

model DiscountCode {
  id              String                   @id @default(cuid())
  organizationId  String
  code            String                   @unique
  description     String?
  discountPercent Decimal                  @db.Decimal(5, 2)
  programId       String?
  maxUses         Int?
  usedCount       Int                      @default(0)
  isActive        Boolean                  @default(true)
  expiresAt       DateTime?
  createdById     String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  createdBy       User                     @relation("CreatedDiscountCodes", fields: [createdById], references: [id], onDelete: Cascade)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  program         Program?                 @relation(fields: [programId], references: [id])
  redemptions     DiscountCodeRedemption[]
  payments        Payment[]

  @@index([organizationId, isActive])
  @@index([code])
}

model DiscountCodeRedemption {
  id         String       @id @default(cuid())
  codeId     String
  userId     String
  paymentId  String       @unique
  redeemedAt DateTime     @default(now())
  code       DiscountCode @relation(fields: [codeId], references: [id], onDelete: Cascade)
  payment    Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([codeId])
  @@index([userId])
}

model Meeting {
  id                   String                 @id @default(cuid())
  organizationId       String?
  cohortId             String?
  hostId               String
  title                String
  description          String?
  startTime            DateTime
  endTime              DateTime
  roomName             String                 @map("dailyRoomName")
  roomUrl              String                 @map("dailyRoomUrl")
  status               MeetingStatus          @default(UPCOMING)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  recordingMode        MeetingRecordingMode   @default(NONE)
  recordingStatus      MeetingRecordingStatus @default(NOT_REQUESTED)
  recordingPlayUrl     String?
  recordingDownloadUrl String?
  recordingJobId       String?                @map("recordingExternalId")
  recordingSyncedAt    DateTime?
  cohort               Cohort?                @relation(fields: [cohortId], references: [id])
  host                 User                   @relation("MeetingHost", fields: [hostId], references: [id], onDelete: Cascade)
