model PasswordResetToken {
  id        String    @id @default(cuid())
  // Stores the SHA-256 hash of the emailed token, never the raw value (see src/lib/reset-token.ts),
  // so a DB leak yields nothing usable. Every write sets the hash explicitly; the uuid() default is
  // only a non-null fallback.
  token     String    @unique @default(uuid())
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
