  slug                String                @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime @updatedAt
  pricePerSeat        Decimal               @default(0) @db.Decimal(10, 2)
  enrollments          Enrollment[]
  inquiries      PartnerInquiry[]
  origins SchoolAllowedOrigin[]
  apiKeys        SchoolApiKey[]
  classes         SchoolClass[]
  teacherTerms  SchoolClassTeacher[]
  invoices       SchoolInvoice[]
  licenses       SchoolLicense[]
  memberships    SchoolMembership[]
  webhooks       SchoolWebhook[]
}

